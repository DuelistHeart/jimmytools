{
	"schemaVersion": 1,
	"id": "jimmytools",
	"version": "${version}",
	"name": "JimmyTools",
	"description": "A mod full of QoL and utility features for LoM2.",
	"authors": [
		"DuelistHeart"
	],
	"contact": {
		"sources": "https://github.com/DuelistHeart/JimmyTools"
	},
	"license": "CC0-1.0",
	"icon": "assets/jimmytools/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.duelco.JimmyTools"
		],
		"client": [
          "com.duelco.JimmyToolsClient"
		],
		"modmenu": [
			"com.duelco.integrations.ModMenuIntegration"
		]
	},
	"mixins": [
		"jimmytools.mixins.json",
		{
			"config": "jimmytools.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.160.0+26.2",
		"owo-lib": ">=0.13.1+26.2",
		"yet_another_config_lib_v3": ">=3.9.6+26.2-fabric"
	},
	"recommends": {
		"modmenu": "*"
	}
}